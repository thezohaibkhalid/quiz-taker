# ============================================================
# Online Quiz Management System — Environment Variables
# Copy this file to .env.local and fill in real values.
# ============================================================

# --- Application ---
NEXT_PUBLIC_APP_NAME="Online Quiz Management System"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- MongoDB Atlas ---
# Example: mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/quizdb?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017/quizdb"

# --- JWT ---
# Use a long random string (e.g. `openssl rand -hex 64`)
JWT_SECRET="replace-this-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# --- Bootstrap admin (created automatically on first start if missing) ---
ADMIN_EMAIL="admin@quizsystem.local"
ADMIN_PASSWORD="ChangeMe!2026"
ADMIN_NAME="System Administrator"

# --- SMTP (Gmail with App Password) ---
# 1. Enable 2FA on your Google account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Use that 16-character password below.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM_NAME="Quiz System"
SMTP_FROM_EMAIL="your-email@gmail.com"

# --- Cloudinary (file & image storage) ---
# Sign up at https://cloudinary.com and copy the credentials from the dashboard.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_UPLOAD_FOLDER="quiz-system"
