# ============================================================
# .env.staging — used by docker-compose.staging.yml on the staging host
# Copy this to .env.staging on the server (DO NOT commit secrets).
# ============================================================

IMAGE=ghcr.io/thezohaibkhalid/quiz-taker:staging

NEXT_PUBLIC_APP_URL=https://cloud.dukandar.app
NEXT_PUBLIC_APP_NAME=Online Quiz Management System (Staging)

# MongoDB Atlas connection string for the STAGING database
MONGODB_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/quizdb_staging

# JWT
JWT_SECRET=replace-with-strong-staging-secret
JWT_EXPIRES_IN=7d

# Bootstrap admin
ADMIN_EMAIL=admin@staging.example.com
ADMIN_PASSWORD=ChangeMe!Staging
ADMIN_NAME=Staging Admin

# Gmail SMTP (App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-staging-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM_NAME=Quiz System (Staging)
SMTP_FROM_EMAIL=your-staging-email@gmail.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=quiz-system-staging
